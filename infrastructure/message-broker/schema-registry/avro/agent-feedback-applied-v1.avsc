{
  "namespace": "com.template.agent",
  "type": "record",
  "name": "AgentFeedbackApplied",
  "doc": "Event produced when the feedback loop adjusts an action-type risk bias. Spec: specs/ai/feedback-loop.md, specs/api/async-api-design.md. ADR: ADR-0038. Topic: agent.feedback.applied. Registered by W11-T2 (issue #347).",
  "fields": [
    { "name": "event_id", "type": "string", "doc": "UUID v4 — stable deduplication key" },
    { "name": "event_type", "type": "string", "doc": "agent.feedback.applied" },
    { "name": "schema_version", "type": "string", "doc": "Semver; must match registered version" },
    { "name": "produced_at", "type": "string", "doc": "ISO8601 UTC timestamp" },
    { "name": "trace_id", "type": "string", "doc": "W3C traceparent" },
    { "name": "producer_service", "type": "string", "doc": "Originating service name" },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "AgentFeedbackAppliedPayload",
        "doc": "No PII: action_type is an enum value, biases are bounded floats.",
        "fields": [
          { "name": "action_type", "type": "string" },
          { "name": "previous_bias", "type": "float", "doc": "0.0–0.5" },
          { "name": "new_bias", "type": "float", "doc": "0.0–0.5" },
          { "name": "direction", "type": "string", "doc": "increase | decrease" },
          { "name": "reason", "type": "string", "doc": "Enum-like rationale code" }
        ]
      }
    }
  ]
}
